+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// License: GPL-3.0
+
+#pragma once
+
+#include "device/capabilities/Capability.h"
+#include "device/NothingDevice.h"
+#include "device/DeviceBattery.h"
+#include "device/enums/DeviceAncModes.h"
+
+namespace MagicPodsCore
+{
+    class NothingCapability : public Capability
+    {
+    protected:
+        NothingDevice &device;
+        virtual void OnReceivedData(const NothingResponseData &data) = 0;
+        void Reset() override;
+
+    public:
+        explicit NothingCapability(const std::string &name, bool isReadOnly, NothingDevice &device);
+        ~NothingCapability() override = default;
+    };
+
+    class NothingAncCapability : public NothingCapability
+    {
+    private:
+        DeviceAncModes option = DeviceAncModes::Off;
+        static DeviceAncModes FromNative(NothingAnc mode);
+        static NothingAnc ToNative(DeviceAncModes mode);
+        void UpdateOption(DeviceAncModes newOption);
+
+    protected:
+        nlohmann::json CreateJsonBody() override;
+        void OnReceivedData(const NothingResponseData &data) override;
+
+    public:
+        explicit NothingAncCapability(NothingDevice &device);
+        void SetFromJson(const nlohmann::json &json) override;
+    };
+
+    class NothingBatteryCapability : public NothingCapability
+    {
+    private:
+        DeviceBattery battery;
+        size_t batteryChangedEventId;
+
+    protected:
+        nlohmann::json CreateJsonBody() override;
+        void OnReceivedData(const NothingResponseData &data) override;
+        void Reset() override;
+
+    public:
+        explicit NothingBatteryCapability(NothingDevice &device);
+        ~NothingBatteryCapability() override;
+        void SetFromJson(const nlohmann::json &json) override {};
+    };
+}
diff --git a/src/sdk/nothing/NothingProtocol.h b/src/sdk/nothing/NothingProtocol.h
new file mode 100644
index 0000000..980b67a
--- /dev/null
+++ b/src/sdk/nothing/NothingProtocol.h
@@ -0,0 +1,175 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// License: GPL-3.0
+//
+// Nothing / CMF earbuds RFCOMM protocol (community reverse-engineered, see
+// https://github.com/debarkak/nothingx-pc). Frame layout:
+//   55 60 01 | cmd | dir | len_lo len_hi | op | payload... | crc16 (LE)
+// Pushes initiated by the earbuds may use header 55 00 01 and carry no CRC.
+
+#pragma once
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace MagicPodsCore
+{
+    enum class NothingCmd : unsigned char
+    {
+        DeviceInfo = 0x06,
+        Battery = 0x07,      // response to a GET request
+        BatteryPush = 0x01,  // earbuds-initiated update (dir 0xE0), same payload as Battery. Confirmed on Ear (a)
+        AncSet = 0x0F,
+        AncGet = 0x1E,
+        AncPush = 0x03,      // earbuds-initiated ANC change (dir 0xE0, payload 01 <mode> 00). Confirmed on Ear (a)
+    };
+
+    enum class NothingDir : unsigned char
+    {
+        Get = 0xC0,
+        Set = 0xF0,
+        Ack = 0x70,
+        Response = 0x40,
+        Unsolicited = 0xE0,
+    };
+
+    enum class NothingAnc : unsigned char
+    {
+        High = 0x01,
+        Mid = 0x02,
+        Low = 0x03,
+        Adaptive = 0x04,
+        Off = 0x05,
+        Transparency = 0x07,
+    };
+
+    struct NothingResponseData
+    {
+        unsigned char Cmd{};
+        unsigned char Direction{};
+        unsigned char OpId{};
+        std::vector<unsigned char> Payload{};
+    };
+
+    class NothingPacket
+    {
+    private:
+        std::vector<unsigned char> _buffer{};
+        std::mutex _mutex{};
+
+    public:
+        // CRC-16/MODBUS, transmitted little-endian
+        static uint16_t Crc16(const unsigned char *data, size_t size)
+        {
+            uint16_t crc = 0xFFFF;
+            for (size_t i = 0; i < size; i++)
+            {
+                crc ^= data[i];
+                for (int b = 0; b < 8; b++)
+                    crc = (crc & 1) ? static_cast<uint16_t>((crc >> 1) ^ 0xA001) : static_cast<uint16_t>(crc >> 1);
+            }
+            return crc;
+        }
+
+        std::vector<unsigned char> Encode(NothingCmd cmd, NothingDir dir, const std::vector<unsigned char> &payload, unsigned char opId = 1)
+        {
+            std::vector<unsigned char> frame{0x55, 0x60, 0x01,
+                                             static_cast<unsigned char>(cmd), static_cast<unsigned char>(dir),
+                                             static_cast<unsigned char>(payload.size() & 0xFF),
+                                             static_cast<unsigned char>((payload.size() >> 8) & 0xFF),
+                                             opId};
+            frame.insert(frame.end(), payload.begin(), payload.end());
+            uint16_t crc = Crc16(frame.data(), frame.size());
+            frame.push_back(static_cast<unsigned char>(crc & 0xFF));
+            frame.push_back(static_cast<unsigned char>(crc >> 8));
+            return frame;
+        }
+
+        // Feed raw RFCOMM bytes, returns every complete frame found (a frame may be split or merged)
+        std::vector<NothingResponseData> Feed(const std::vector<unsigned char> &data)
+        {
+            std::lock_guard lock{_mutex};
+            std::vector<NothingResponseData> result;
+            _buffer.insert(_buffer.end(), data.begin(), data.end());
+
+            while (_buffer.size() >= 8)
+            {
+                auto start = std::find(_buffer.begin(), _buffer.end(), static_cast<unsigned char>(0x55));
+                if (start == _buffer.end())
+                {
+                    _buffer.clear();
+                    break;
+                }
+                _buffer.erase(_buffer.begin(), start);
+                if (_buffer.size() < 8)
+                    break;
+
+                bool standard = _buffer[1] == 0x60 && _buffer[2] == 0x01;
+                bool unsolicited = _buffer[1] == 0x00 && _buffer[2] == 0x01;
+                if (!standard && !unsolicited)
+                {
+                    _buffer.erase(_buffer.begin());
+                    continue;
+                }
+
+                size_t payloadLen = _buffer[5] | (static_cast<size_t>(_buffer[6]) << 8);
+                size_t total = 8 + payloadLen + (standard ? 2 : 0);
+                if (_buffer.size() < total)
+                    break;
+
+                if (standard)
+                {
+                    uint16_t got = static_cast<uint16_t>(_buffer[total - 2] | (_buffer[total - 1] << 8));
+                    uint16_t full = Crc16(_buffer.data(), total - 2);
+                    uint16_t payloadOnly = Crc16(_buffer.data() + 8, payloadLen);
+                    if (got != full && got != payloadOnly)
+                    {
+                        _buffer.erase(_buffer.begin());
+                        continue;
+                    }
+                }
+
+                NothingResponseData packet;
+                packet.Cmd = _buffer[3];
+                packet.Direction = _buffer[4];
+                packet.OpId = _buffer[7];
+                packet.Payload.assign(_buffer.begin() + 8, _buffer.begin() + 8 + payloadLen);
+                result.push_back(std::move(packet));
+                _buffer.erase(_buffer.begin(), _buffer.begin() + total);
+            }
+            return result;
+        }
+    };
+
+    class NothingHelper
+    {
+    public:
+        inline static const std::string A2DP_SINK = "0000110b-0000-1000-8000-00805f9b34fb";
+        inline static const std::string SPP = "00001101-0000-1000-8000-00805f9b34fb";
+        // Custom service UUID of Nothing earbuds, present on Ear (a) (RFCOMM channel is resolved through SDP).
+        // If a model lacks it, the standard SPP UUID is used instead.
+        inline static const std::string NOTHING_SERVICE = "aeac4a03-dff5-498f-843a-34487cf133eb";
+
+        static bool IsNothingDevice(const std::string &name, const std::vector<std::string> &uuids)
+        {
+            std::string lower = name;
+            std::transform(lower.begin(), lower.end(), lower.begin(), [](unsigned char c) { return std::tolower(c); });
+            bool nameMatch = lower.find("nothing ear") != std::string::npos ||
+                             lower.find("cmf buds") != std::string::npos ||
+                             lower.find("cmf headphone") != std::string::npos;
+            // Audio sink required, so e.g. a paired Nothing Phone is not picked up
+            bool isAudio = std::find(uuids.begin(), uuids.end(), A2DP_SINK) != uuids.end();
+            return nameMatch && isAudio;
+        }
+
+        static std::string GetServiceGuid(const std::vector<std::string> &uuids)
+        {
+            if (std::find(uuids.begin(), uuids.end(), NOTHING_SERVICE) != uuids.end())
+                return NOTHING_SERVICE;
+            return SPP;
+        }
+    };
+}
