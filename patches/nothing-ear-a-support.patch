+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// License: GPL-3.0
+
+#pragma once
+
+#include "Event.h"
+#include "Device.h"
+#include "sdk/nothing/NothingProtocol.h"
+
+namespace MagicPodsCore
+{
+    class NothingDevice : public Device
+    {
+    private:
+        Event<NothingResponseData> _ResponseDataRecived{};
+        NothingPacket _packet;
+        void OnResponseDataReceived(const std::vector<unsigned char> &data) override;
+
+    public:
+        explicit NothingDevice(std::shared_ptr<DBusDeviceInfo> deviceInfo, std::shared_ptr<PulseAudioClient> audioClient, std::shared_ptr<SettingsService> settingsService);
+
+        Event<NothingResponseData> &GetResponseDataRecived()
+        {
+            return _ResponseDataRecived;
+        }
+
+        void SendPacket(NothingCmd cmd, NothingDir dir, const std::vector<unsigned char> &payload);
+
+        static std::shared_ptr<NothingDevice> Create(std::shared_ptr<DBusDeviceInfo> deviceInfo, std::shared_ptr<PulseAudioClient> audioClient, std::shared_ptr<SettingsService> settingsService);
+    };
+}
diff --git a/src/device/capabilities/nothing/NothingCapabilities.cpp b/src/device/capabilities/nothing/NothingCapabilities.cpp
new file mode 100644
index 0000000..e050f16
--- /dev/null
+++ b/src/device/capabilities/nothing/NothingCapabilities.cpp
@@ -0,0 +1,215 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// License: GPL-3.0
+
+#include "NothingCapabilities.h"
+#include "Logger.h"
+
+namespace MagicPodsCore
+{
+    // ---------- base ----------
+
+    NothingCapability::NothingCapability(const std::string &name, bool isReadOnly, NothingDevice &device)
+        : Capability(name, isReadOnly), device(device)
+    {
+        this->device.GetResponseDataRecived().Subscribe([this](size_t id, const NothingResponseData &data) { OnReceivedData(data); });
+
+        this->device.GetClientStateChangedEvent().Subscribe([this](size_t id, ClientState state) {
+            if (state == ClientState::Disconnected)
+            {
+                Reset();
+                _onChanged.FireEvent(*this);
+            }
+        });
+    }
+
+    void NothingCapability::Reset()
+    {
+        Capability::Reset();
+    }
+
+    // ---------- ANC ----------
+
+    DeviceAncModes NothingAncCapability::FromNative(NothingAnc mode)
+    {
+        switch (mode)
+        {
+        case NothingAnc::Off:
+            return DeviceAncModes::Off;
+        case NothingAnc::Transparency:
+            return DeviceAncModes::Transparency;
+        case NothingAnc::Adaptive:
+            return DeviceAncModes::Adaptive;
+        // The UI has a single noise cancellation slot, so all strengths are shown as one
+        case NothingAnc::High:
+        case NothingAnc::Mid:
+        case NothingAnc::Low:
+        default:
+            return DeviceAncModes::NoiseCancellation;
+        }
+    }
+
+    NothingAnc NothingAncCapability::ToNative(DeviceAncModes mode)
+    {
+        switch (mode)
+        {
+        case DeviceAncModes::Off:
+            return NothingAnc::Off;
+        case DeviceAncModes::Transparency:
+            return NothingAnc::Transparency;
+        case DeviceAncModes::Adaptive:
+            return NothingAnc::Adaptive;
+        default: // NoiseCancellation, WindCancellation
+            return NothingAnc::High;
+        }
+    }
+
+    nlohmann::json NothingAncCapability::CreateJsonBody()
+    {
+        unsigned char options = static_cast<unsigned char>(DeviceAncModes::Off) |
+                                static_cast<unsigned char>(DeviceAncModes::Transparency) |
+                                static_cast<unsigned char>(DeviceAncModes::Adaptive) |
+                                static_cast<unsigned char>(DeviceAncModes::NoiseCancellation);
+        auto body = nlohmann::json::object();
+        body["selected"] = option;
+        body["options"] = options;
+        return body;
+    }
+
+    void NothingAncCapability::UpdateOption(DeviceAncModes newOption)
+    {
+        if (!isAvailable || option != newOption)
+        {
+            isAvailable = true;
+            option = newOption;
+            Logger::Info("ANC updated: %s", DeviceAncModesToString(option).c_str());
+            _onChanged.FireEvent(*this);
+        }
+    }
+
+    void NothingAncCapability::OnReceivedData(const NothingResponseData &data)
+    {
+        const auto &p = data.Payload;
+        unsigned char mode = 0;
+
+        if (data.Cmd == static_cast<unsigned char>(NothingCmd::AncGet) && p.size() >= 2)
+        {
+            if (p[0] == 0x01)
+                mode = p[1];
+            else if (p.size() >= 5 && p[3] == 0x01)
+                mode = p[4];
+            else
+                mode = p[1];
+        }
+        else if (data.Cmd == static_cast<unsigned char>(NothingCmd::AncPush) &&
+                 data.Direction == static_cast<unsigned char>(NothingDir::Unsolicited) &&
+                 p.size() == 3 && p[0] == 0x01)
+        {
+            mode = p[1];
+        }
+        else
+            return;
+
+        switch (static_cast<NothingAnc>(mode))
+        {
+        case NothingAnc::High:
+        case NothingAnc::Mid:
+        case NothingAnc::Low:
+        case NothingAnc::Adaptive:
+        case NothingAnc::Off:
+        case NothingAnc::Transparency:
+            UpdateOption(FromNative(static_cast<NothingAnc>(mode)));
+            break;
+        default:
+            Logger::Debug("NothingAncCapability: unknown mode %d", mode);
+        }
+    }
+
+    NothingAncCapability::NothingAncCapability(NothingDevice &device) : NothingCapability("anc", false, device) {}
+
+    void NothingAncCapability::SetFromJson(const nlohmann::json &json)
+    {
+        if (!json.contains(name))
+            return;
+
+        const auto &capability = json.at(name);
+        if (!capability.contains("selected") || !capability["selected"].is_number_integer())
+        {
+            Logger::Info("Error: NothingAncCapability::SetFromJson got no value or value is not an integer");
+            return;
+        }
+
+        unsigned char selected = static_cast<unsigned char>(capability["selected"].get<int>());
+        if (!isValidDeviceAncModesType(selected))
+        {
+            Logger::Info("Error: NothingAncCapability::SetFromJson got unexpected option: %d", selected);
+            return;
+        }
+
+        NothingAnc native = ToNative(static_cast<DeviceAncModes>(selected));
+        device.SendPacket(NothingCmd::AncSet, NothingDir::Set, {0x01, static_cast<unsigned char>(native), 0x00});
+        // Read back the real state so the UI always reflects what the earbuds accepted
+        device.SendPacket(NothingCmd::AncGet, NothingDir::Get, {});
+        Logger::Debug("NothingAncCapability::SetFromJson set native mode %d", static_cast<int>(native));
+    }
+
+    // ---------- battery ----------
+
+    nlohmann::json NothingBatteryCapability::CreateJsonBody()
+    {
+        return battery.CreateJsonBody();
+    }
+
+    void NothingBatteryCapability::Reset()
+    {
+        battery.ClearBattery();
+        NothingCapability::Reset();
+    }
+
+    void NothingBatteryCapability::OnReceivedData(const NothingResponseData &data)
+    {
+        bool isResponse = data.Cmd == static_cast<unsigned char>(NothingCmd::Battery);
+        bool isPush = data.Cmd == static_cast<unsigned char>(NothingCmd::BatteryPush) &&
+                      data.Direction == static_cast<unsigned char>(NothingDir::Unsolicited);
+        // Note: Ear (a) also sends unsolicited cmd 0x02 packets with a similar layout but unexplained values, they are ignored on purpose
+        if ((!isResponse && !isPush) || data.Payload.empty())
+            return;
+
+        // payload: [count] then (tag, value) pairs. tag 2 = left, 3 = right, 4 = case.
+        // value: low 7 bits = percent, bit 7 = charging (charging bit not yet confirmed on real hardware)
+        std::vector<DeviceBatteryData> result;
+        const auto &p = data.Payload;
+        for (size_t i = 1; i + 1 < p.size(); i += 2)
+        {
+            DeviceBatteryType type;
+            if (p[i] == 0x02)
+                type = DeviceBatteryType::Left;
+            else if (p[i] == 0x03)
+                type = DeviceBatteryType::Right;
+            else if (p[i] == 0x04)
+                type = DeviceBatteryType::Case;
+            else
+                continue;
+
+            short level = p[i + 1] & 0x7F;
+            bool charging = (p[i + 1] & 0x80) != 0;
+            result.emplace_back(type, level == 0 ? DeviceBatteryStatus::Disconnected : DeviceBatteryStatus::Connected, level, charging);
+        }
+
+        if (!result.empty())
+            battery.UpdateBattery(result);
+    }
+
+    NothingBatteryCapability::NothingBatteryCapability(NothingDevice &device) : NothingCapability("battery", true, device), battery(true)
+    {
+        batteryChangedEventId = battery.GetBatteryChangedEvent().Subscribe([this](size_t id, const std::vector<DeviceBatteryData> &b) {
+            if (!isAvailable)
+                isAvailable = true;
+            _onChanged.FireEvent(*this);
+        });
+    }
+
+    NothingBatteryCapability::~NothingBatteryCapability()
+    {
+        battery.GetBatteryChangedEvent().Unsubscribe(batteryChangedEventId);
+    }
+}
