@@ -0,0 +1,45 @@
+// MagicPodsCore: https://github.com/steam3d/MagicPodsCore
+// License: GPL-3.0
+
+#include "NothingDevice.h"
+
+#include "capabilities/nothing/NothingCapabilities.h"
+#include "capabilities/cmn/CmnBluetoothCodecCapability.h"
+
+namespace MagicPodsCore
+{
+    void NothingDevice::OnResponseDataReceived(const std::vector<unsigned char> &data)
+    {
+        for (const auto &packet : _packet.Feed(data))
+        {
+            Logger::Debug("%s: nothing packet cmd=0x%02X dir=0x%02X len=%zu", GetName().c_str(), packet.Cmd, packet.Direction, packet.Payload.size());
+            _ResponseDataRecived.FireEvent(packet);
+        }
+    }
+
+    NothingDevice::NothingDevice(std::shared_ptr<DBusDeviceInfo> deviceInfo, std::shared_ptr<PulseAudioClient> audioClient, std::shared_ptr<SettingsService> settingsService)
+        : Device(deviceInfo, audioClient, settingsService) {}
+
+    void NothingDevice::SendPacket(NothingCmd cmd, NothingDir dir, const std::vector<unsigned char> &payload)
+    {
+        _client->SendData(_packet.Encode(cmd, dir, payload));
+    }
+
+    std::shared_ptr<NothingDevice> NothingDevice::Create(std::shared_ptr<DBusDeviceInfo> deviceInfo, std::shared_ptr<PulseAudioClient> audioClient, std::shared_ptr<SettingsService> settingsService)
+    {
+        auto device = std::make_shared<NothingDevice>(deviceInfo, audioClient, settingsService);
+
+        device->capabilities.push_back(std::make_unique<CmnBluetoothCodecCapability>(*device));
+        device->capabilities.push_back(std::make_unique<NothingBatteryCapability>(*device));
+        device->capabilities.push_back(std::make_unique<NothingAncCapability>(*device));
+
+        // Earbuds answer only to requests, so ask for the current state right after connecting
+        NothingPacket packet;
+        device->_clientStartData.push_back(packet.Encode(NothingCmd::Battery, NothingDir::Get, {}));
+        device->_clientStartData.push_back(packet.Encode(NothingCmd::AncGet, NothingDir::Get, {}));
+
+        device->_client = Client::CreateRFCOMM(deviceInfo->GetAddress(), NothingHelper::GetServiceGuid(deviceInfo->GetUuids()));
+        device->Init();
+        return device;
+    }
+}
